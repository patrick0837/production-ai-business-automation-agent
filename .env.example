APP_NAME=Production-Ready AI Business Automation Agent
APP_VERSION=0.1.0
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/automation_agent
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/automation_agent_test

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

DOCKER_DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:5432/automation_agent

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct

EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_DIMENSIONS=768

WEBHOOK_SECRET=replace-with-a-secure-secret

N8N_ENCRYPTION_KEY=replace-with-a-secure-encryption-key
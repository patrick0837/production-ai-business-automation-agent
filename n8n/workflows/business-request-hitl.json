              "id": "f6999500-1c16-48ea-b9e4-91d08e702ae9",
              "leftValue": "={{ $json.Decision === 'Approve' }}",
              "rightValue": "Approve",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
